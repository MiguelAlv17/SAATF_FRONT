
# Origen (host) de la API. SOLO el origen: los endpoints del código ya incluyen
# el prefijo /api (ej. /api/auth/login).
#
#   - En DESARROLLO déjala VACÍA / sin definir: las llamadas salen como /api/... y
#     el proxy de Vite (vite.config.js) las reenvía a QA.
#   - En PRODUCCIÓN ponla al origen real de la API (sin barra final, sin /api):
#
# Ejemplos:
#   VITE_API_BASE=https://api.saatf.qa.payfri-bi.com   # QA
#   VITE_API_BASE=https://api.saatf.payfri-bi.com      # Producción (ejemplo)

VITE_API_BASE=
